# Transactional email (Resend). All four are required — the server throws on a
# missing value rather than falling back to a default.
RESEND_API_KEY=
# Display name and address messages are sent from. The domain must be verified
# in Resend or delivery will be rejected.
FROM_NAME=
FROM_EMAIL=
# Where enquiry, booking and subscription notifications are delivered.
TO_EMAIL=

# --- Not yet wired -----------------------------------------------------------
# RESEND_AUDIENCE_ID  — needed to add newsletter subscribers to a mailing list.
#                       Until it exists, /api/newsletter sends the welcome and
#                       the internal notification but writes to no list.
